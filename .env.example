# AWS (leave all blank to run in mock/demo mode with in-memory sample data)

# Shared
AWS_REGION=

# Aurora Serverless v2 (PostgreSQL-compatible), accessed via the RDS Data API — no VPC
# networking or connection pooling needed. Create the cluster with "Data API" enabled and
# min capacity 0 ACU (scale-to-zero) to keep idle cost near-zero.
DB_CLUSTER_ARN=
DB_SECRET_ARN=
DB_NAME=ownova

# Cognito User Pool. App client must have NO client secret and
# "ALLOW_USER_PASSWORD_AUTH" enabled under Auth flows.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# S3 bucket for documents (contracts, invoices, brand assets, client files).
S3_BUCKET_NAME=

# IAM credentials for local development only. In production (Amplify Hosting / ECS / Lambda),
# skip these entirely and attach an IAM role with the required permissions instead — never
# commit access keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
