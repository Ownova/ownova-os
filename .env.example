# AWS (leave all blank to run in mock/demo mode with in-memory sample data)
#
# NOTE: these are named APP_AWS_* (not AWS_*) because AWS Amplify Hosting reserves the
# "AWS_" env var prefix for its own internal use and refuses to deploy if you set one.

# Shared
APP_AWS_REGION=

# Aurora Serverless v2 (PostgreSQL-compatible), accessed via the RDS Data API — no VPC
# networking or connection pooling needed. Create the cluster with "Data API" enabled and
# min capacity 0 ACU (scale-to-zero) to keep idle cost near-zero.
DB_CLUSTER_ARN=
DB_SECRET_ARN=
DB_NAME=ownova

# Cognito User Pool. App client must have NO client secret and
# "ALLOW_USER_PASSWORD_AUTH" enabled under Auth flows.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# S3 bucket for documents (contracts, invoices, brand assets, client files).
S3_BUCKET_NAME=

# IAM credentials for LOCAL DEVELOPMENT ONLY — never commit real values.
#
# Production does not use these. The deployed app authenticates through the Amplify SSR compute
# role `ownova-os-amplify-compute`, which grants only: RDS Data API on the ownova-os-db cluster,
# GetSecretValue on that cluster's secret, object read/write on the documents bucket, and the
# specific Cognito sign-in/sign-up actions on the user pool. Those credentials are temporary and
# rotated automatically, so there is no long-lived key to leak or rotate by hand.
APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=

# Verified SES identity used as the From address when emailing invoices to clients.
# Leave blank to disable email delivery (the Send button then explains it is not set up).
# Format: "Ownova <billing@ownova.org>"
SES_FROM_ADDRESS=

# ---- Automated lead intake -------------------------------------------------------------------
# Shared secrets for /api/intake/*. These routes are reachable without a Cognito session (Apps
# Script and Cal.com cannot log in), so they authenticate with these instead. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(36))"
# Must be at least 24 characters -- the app refuses anything shorter so a placeholder can't
# quietly ship to production. See docs/LEAD-PIPELINE-SETUP.md.
INTAKE_SECRET=
CAL_WEBHOOK_SECRET=
